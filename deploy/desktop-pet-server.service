[Unit]
Description=Desktop Pet WebSocket Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/desktop-pet-server
ExecStart=/usr/bin/node /opt/desktop-pet-server/pet-server.js --host 0.0.0.0 --port 17890 --admin-token dushi1117
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
