{
  "name": "ai-desktop-pet",
  "productName": "桌面小助手",
  "version": "2.2.0",
  "description": "Desktop pet assistant with chat, vision, reminders, networking, and Pi agent integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/**/*.test.js",
    "server": "node pet-server.js",
    "prepare:pi": "npm --prefix third_party/pi install --ignore-scripts && NODE_OPTIONS=--experimental-strip-types npm --prefix third_party/pi run build",
    "prebuild": "npm run prepare:pi",
    "prebuild:mac": "npm run prepare:pi",
    "prebuild:portable": "npm run prepare:pi",
    "prebuild:all": "npm run prepare:pi",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win --x64",
    "menu:hide": "node toggle-menu.js hide",
    "menu:minimal": "node toggle-menu.js minimal",
    "menu:custom": "node toggle-menu.js custom"
  },
  "keywords": [
    "ai",
    "desktop-pet",
    "vision",
    "electron",
    "pi-agent"
  ],
  "author": {
    "name": "king.wang"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.king.desktop-helper",
    "productName": "桌面小助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config-change-notifier.js",
      "vision-capabilities.js",
      "openai-compatible.js",
      "deepseek-plugin.js",
      "generated-image-export.js",
      "conversation-history.js",
      "conversation-save-path.js",
      "image-generation-config.js",
      "image-generation-log.js",
      "reminder-manager.js",
      "portable-restart.js",
      "pet-device-identity.js",
      "pet-network-client.js",
      "pet-network-protocol.js",
      "pet-server.js",
      "preload.js",
      "config.js",
      "pi-agent-service.js",
      "config/prompt-templates.json",
      "store.js",
      "api-service.js",
      "package.json",
      "sha3_wasm_bg.7b9ca65ddd.wasm",
      "renderer/**/*",
      "assets/bubu/**/*",
      "assets/yier/**/*",
      "assets/shiba.jpg",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon.icns",
      "node_modules/**/*",
      "!**/*.md",
      "!**/test/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "sha3_wasm_bg.7b9ca65ddd.wasm",
        "to": "sha3_wasm_bg.7b9ca65ddd.wasm"
      },
      {
        "from": "third_party/pi",
        "to": "pi",
        "filter": [
          "**/*",
          "!**/src/**",
          "!**/test/**",
          "!**/*.ts",
          "!**/*.map",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "桌面小助手",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "桌面小助手-便携版.exe"
    }
  }
}
